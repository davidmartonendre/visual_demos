{
  "routes": [
    {
      "route": "/*.md",
      "statusCode": 404
    },
    {
      "route": "/.gitignore",
      "statusCode": 404
    },
    {
      "route": "/tests/*",
      "statusCode": 404
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "globalHeaders": {
    "Cache-Control": "no-cache",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer"
  },
  "mimeTypes": {
    ".html": "text/html",
    ".json": "application/json"
  }
}
